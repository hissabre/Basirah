{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "strict": true,
  "noEmit": true,
  "allowImportingTsExtensions": true,
  "lib": [
   "ES2022",
   "DOM",
   "DOM.Iterable"
  ],
  "skipLibCheck": true,
  "resolveJsonModule": true
 },
 "include": [
  "src",
  "app/main.ts"
 ],
 "exclude": [
  "src/eval/cli.ts"
 ]
}